# Copy to deploy/.env on the VPS (mode 0600). Never commit real secrets.
# Formal production domain for this project:
RELAY_DOMAIN=p2p.aikissgo.com

# Generate with: openssl rand -hex 32
# Must be at least 32 characters. Store only on the VPS / CI secrets.
RELAY_ACCESS_TOKEN=CHANGE_TO_64_RANDOM_HEX_CHARACTERS_BEFORE_DEPLOYMENT

# Optional: pin the relay image tag / git SHA used by update.sh (informational).
# RELAY_IMAGE_TAG=p2p-relay:local
